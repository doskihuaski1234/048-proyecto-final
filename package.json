             },
    "homepage":  "https://github.com/doskihuaski1234/048-proyecto-final#readme",
    "devDependencies":  {
                            "@playwright/test":  "^1.64.0",
                            "@types/node":  "^26.6.4",
                            "typescript":  "^7.0.2"
                        }
}
