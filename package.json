{
    "name":  "048-proyecto-final",
    "version":  "1.0.0",
    "description":  "Proyecto final de pruebas automatizadas con Playwright y TypeScript",
    "main":  "index.js",
    "scripts":  {
                    "test":  "playwright test",
                    "test:headed":  "playwright test --headed",
                    "test:ui":  "playwright test --ui",
                    "test:report":  "playwright show-report",
                    "test:single":  "playwright test --workers=1",
                    "smoke":  "playwright test tests/smoke.spec.ts",
                    "funcional":  "playwright test tests/funcional.spec.ts",
                    "instalacion":  "playwright test tests/instalacion.spec.ts",
                    "chromium":  "playwright test --project=chromium",
                    "firefox":  "playwright test --project=firefox",
                    "webkit":  "playwright test --project=webkit",
                    "visible":  "playwright test --headed"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/doskihuaski1234/048-proyecto-final.git"
                   },
    "keywords":  [

                 ],
